<resources>
    <!-- Always light: the app is not meant to be shown in dark mode. -->
    <style name="Theme.VoltWise" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_100</item>
        <item name="colorOnPrimaryContainer">@color/teal_900</item>
        <item name="colorSecondary">@color/amber_500</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSecondaryContainer">@color/amber_100</item>
        <item name="colorOnSecondaryContainer">@color/amber_900</item>
        <item name="colorError">@color/red_700</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="VoltWise.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/teal_900</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white_80</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="VoltWise.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="VoltWise.SectionTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teal_900</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="VoltWise.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="VoltWise.Value" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="VoltWise.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
